    "## 4) Partial Derivatives & Gradient\n",
    "\n",
    "We compute the gradient of a simple function and visualize its contours with gradient vectors.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "717e36c3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# f(x,y) = x^2 + y^2  => grad f = [2x, 2y]\n",
    "def f(x, y):\n",
    "    return x**2 + y**2\n",
    "\n",
    "def grad_f(x, y):\n",
    "    return np.array([2*x, 2*y])\n",
    "\n",
    "# Create a grid and plot contours plus a few gradient vectors\n",
    "xs = np.linspace(-3, 3, 100)\n",
    "ys = np.linspace(-3, 3, 100)\n",
    "Xg, Yg = np.meshgrid(xs, ys)\n",
    "Z = f(Xg, Yg)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6, 6))\n",
    "CS = ax.contour(Xg, Yg, Z, levels=15)\n",
    "ax.clabel(CS, inline=True, fontsize=8)\n",
    "\n",
    "# Some sample points to show gradient vectors\n",
    "samples = np.array([[-2.0, -1.5], [1.5, -1.0], [2.0, 2.0], [-1.0, 2.0]])\n",
    "for (x0, y0) in samples:\n",
    "    g = grad_f(x0, y0)\n",
    "    ax.arrow(x0, y0, g[0]*0.2, g[1]*0.2, head_width=0.1, length_includes_head=True)\n",
    "\n",
    "ax.set_aspect('equal', 'box')\n",
    "ax.set_title(\"Contours of f(x,y)=x^2+y^2 with gradient vectors\")\n",
    "ax.set_xlabel(\"x\")\n",
    "ax.set_ylabel(\"y\")\n",
    "plt.show()"
   ]
  },
  {
