    "### Mini‑Batch vs Stochastic (Toy Illustration)\n",
    "\n",
    "We fit a 1D linear regression $y \\approx a x + b$ with MSE loss, and compare **batch** vs **mini‑batch** vs **stochastic** updates to see different convergence behaviors (on a tiny synthetic dataset).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8e40e4b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "rng = np.random.default_rng(42)\n",
    "X = np.linspace(-2, 2, 50)\n",
    "true_a, true_b = 1.7, -0.5\n",
    "y = true_a * X + true_b + rng.normal(0, 0.3, size=X.shape)\n",
    "\n",
    "def mse(a, b):\n",
    "    pred = a*X + b\n",
    "    return np.mean((pred - y)**2)\n",
    "\n",
    "def grad_mse_batch(a, b):\n",
    "    pred = a*X + b\n",
    "    da = 2*np.mean((pred - y) * X)\n",
    "    db = 2*np.mean(pred - y)\n",
    "    return da, db\n",
    "\n",
    "def sgd(a0, b0, lr=0.1, n_epoch=20, batch_size=None):\n",
    "    a, b = a0, b0\n",
    "    losses = []\n",
    "    for epoch in range(n_epoch):\n",
    "        idx = np.arange(len(X))\n",
    "        rng.shuffle(idx)\n",
    "        for start in range(0, len(X), batch_size if batch_size else 1):\n",
    "            end = min(len(X), start + (batch_size if batch_size else 1))\n",
    "            ids = idx[start:end]\n",
    "            Xi, yi = X[ids], y[ids]\n",
    "            pred = a*Xi + b\n",
    "            da = 2*np.mean((pred - yi) * Xi)\n",
    "            db = 2*np.mean(pred - yi)\n",
    "            a -= lr*da\n",
    "            b -= lr*db\n",
    "            losses.append(mse(a, b))\n",
    "    return a, b, np.array(losses)\n",
    "\n",
    "# Batch GD (one gradient per epoch)\n",
    "def gd_batch(a0, b0, lr=0.1, n_epoch=50):\n",
    "    a, b = a0, b0\n",
    "    losses = []\n",
    "    for _ in range(n_epoch):\n",
    "        da, db = grad_mse_batch(a, b)\n",
    "        a -= lr*da\n",
    "        b -= lr*db\n",
    "        losses.append(mse(a, b))\n",
    "    return a, b, np.array(losses)\n",
    "\n",
    "# Compare\n",
    "ab0 = (0.0, 0.0)\n",
    "a_b_gd, b_b_gd, loss_batch = gd_batch(*ab0, lr=0.3, n_epoch=60)\n",
    "a_b_sgd, b_b_sgd, loss_sgd = sgd(*ab0, lr=0.05, n_epoch=20, batch_size=1)     # Stochastic\n",
    "a_b_mb,  b_b_mb,  loss_mb  = sgd(*ab0, lr=0.1,  n_epoch=20, batch_size=10)    # Mini-batch\n",
    "\n",
    "print(\"Batch GD params:\", a_b_gd, b_b_gd)\n",
    "print(\"SGD params:\", a_b_sgd, b_b_sgd)\n",
    "print(\"Mini-batch params:\", a_b_mb, b_b_mb)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6,4))\n",
    "ax.plot(loss_batch, label=\"Batch GD\")\n",
    "ax.plot(loss_sgd, label=\"SGD\")\n",
    "ax.plot(loss_mb,  label=\"Mini-batch\")\n",
    "ax.set_xlabel(\"update step\")\n",
    "ax.set_ylabel(\"MSE loss\")\n",
    "ax.set_title(\"Convergence comparison\")\n",
    "ax.legend()\n",
    "plt.show()"
   ]
  },
