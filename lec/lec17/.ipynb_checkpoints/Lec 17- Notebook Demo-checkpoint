    "### PCA Mini‑Demo (2D → 1D)\n",
    "\n",
    "We generate correlated 2D data, compute the covariance matrix, and use eigenvectors of the covariance to find principal directions. We then project to 1D.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "efd2de7e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate correlated 2D data\n",
    "rng = np.random.default_rng(7)\n",
    "mean = np.array([0.0, 0.0])\n",
    "cov = np.array([[3.0, 2.2],\n",
    "                [2.2, 2.0]])  # positive semi-definite\n",
    "X = rng.multivariate_normal(mean, cov, size=400)\n",
    "\n",
    "# PCA via covariance eigendecomposition\n",
    "Xc = X - X.mean(axis=0)\n",
    "C = np.cov(Xc, rowvar=False)\n",
    "w, V = np.linalg.eig(C)\n",
    "\n",
    "# Sort by eigenvalue (descending)\n",
    "idx = np.argsort(w)[::-1]\n",
    "w = w[idx]\n",
    "V = V[:, idx]\n",
    "\n",
    "# Project onto first PC\n",
    "pc1 = V[:, 0]\n",
    "X1 = Xc @ pc1\n",
    "\n",
    "print(\"Eigenvalues (variance along PCs):\", w)\n",
    "print(\"Explained variance ratio (PC1):\", w[0] / w.sum())\n",
    "\n",
    "# Plot data and PC1 direction\n",
    "fig, ax = plt.subplots(figsize=(6, 6))\n",
    "ax.scatter(X[:,0], X[:,1], s=8, alpha=0.7)\n",
    "origin = X.mean(axis=0)\n",
    "scale = math.sqrt(w[0]) * 2.0\n",
    "ax.arrow(origin[0], origin[1], pc1[0]*scale, pc1[1]*scale, \n",
    "         head_width=0.2, length_includes_head=True)\n",
    "ax.set_aspect('equal', 'box')\n",
    "ax.set_title(\"2D data with first principal component\")\n",
    "ax.set_xlabel(\"x1\")\n",
    "ax.set_ylabel(\"x2\")\n",
    "plt.show()\n",
    "\n",
    "# Histogram of 1D projection\n",
    "fig, ax = plt.subplots(figsize=(6, 4))\n",
    "ax.hist(X1, bins=30)\n",
    "ax.set_title(\"Projection onto PC1\")\n",
    "ax.set_xlabel(\"scores (PC1)\")\n",
    "ax.set_ylabel(\"count\")\n",
    "plt.show()"
   ]
  },
