   "source": [
    "### Chain Rule (Numeric Check)\n",
    "\n",
    "Let $z = x^2 + y^2$ with $x=t^2,\\ y=3t$. Then \n",
    "$$\\frac{dz}{dt} = 2x\\frac{dx}{dt} + 2y\\frac{dy}{dt} = 4t^3 + 18t.$$\n",
    "\n",
    "We verify numerically via finite differences.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "365017ac",
   "metadata": {},
   "outputs": [],
   "source": [
    "def z_of_t(t):\n",
    "    x = t**2\n",
    "    y = 3*t\n",
    "    return x**2 + y**2\n",
    "\n",
    "def dz_dt_chain(t):\n",
    "    return 4*(t**3) + 18*t\n",
    "\n",
    "def finite_diff(f, t, h=1e-6):\n",
    "    return (f(t+h) - f(t-h)) / (2*h)\n",
    "\n",
    "ts = np.linspace(-2, 2, 9)\n",
    "table = []\n",
    "for t in ts:\n",
    "    exact = dz_dt_chain(t)\n",
    "    approx = finite_diff(z_of_t, t)\n",
    "    table.append((t, exact, approx, abs(exact-approx)))\n",
    "\n",
    "print(\" t     exact_dz/dt   finite_diff    abs_error\")\n",
    "for row in table:\n",
    "    print(f\"{row[0]: .2f}   {row[1]: .6f}    {row[2]: .6f}   {row[3]: .2e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6f26a9cb",
   "metadata": {},
   "source": [
    "## 5) Gradient Descent (1D)\n",
    "\n",
    "We minimize $J(\\theta) = (\\theta - 3)^2$ with learning rate \\(\\eta=0.1\\)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "81b45d97",
   "metadata": {},
   "outputs": [],
   "source": [
    "def J(theta):\n",
    "    return (theta - 3.0)**2\n",
    "\n",
    "def dJ(theta):\n",
    "    return 2.0*(theta - 3.0)\n",
    "\n",
    "def gradient_descent(theta0=0.0, lr=0.1, n_iter=20):\n",
    "    thetas = [theta0]\n",
    "    costs = [J(theta0)]\n",
    "    for k in range(n_iter):\n",
    "        g = dJ(thetas[-1])\n",
    "        new_theta = thetas[-1] - lr*g\n",
    "        thetas.append(new_theta)\n",
    "        costs.append(J(new_theta))\n",
    "    return np.array(thetas), np.array(costs)\n",
    "\n",
    "thetas, costs = gradient_descent(theta0=0.0, lr=0.1, n_iter=15)\n",
    "print(\"Iteration  theta      grad        cost\")\n",
    "for k in range(len(thetas)-1):\n",
    "    print(f\"{k:3d}      {thetas[k]:7.3f}   {dJ(thetas[k]):7.3f}   {costs[k]:7.3f}\")\n",
    "\n",
    "# Plot cost over iterations\n",
    "fig, ax = plt.subplots(figsize=(6,4))\n",
    "ax.plot(costs, marker='o')\n",
    "ax.set_xlabel(\"iteration\")\n",
    "ax.set_ylabel(\"J(theta)\")\n",
    "ax.set_title(\"Gradient Descent on J(theta) = (theta-3)^2\")\n",
    "plt.show()"
   ]
  },
